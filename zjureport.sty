\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{zjureport}[2026/04/29 ZJU experiment report template]

%% 页边距
\RequirePackage[left=2.50cm,right=2.50cm,top=2.50cm,bottom=2.50cm]{geometry}

%% 一些必要的宏包
\RequirePackage{amsmath,amssymb,bm}
\RequirePackage{array,booktabs,tabularx}
\RequirePackage{caption}
\RequirePackage{enumitem}
\RequirePackage{eso-pic}
\RequirePackage{fancyhdr}
\RequirePackage{float}
\RequirePackage{fontspec}
\RequirePackage{graphicx}
\RequirePackage{hyperref}
\RequirePackage{listings}
\RequirePackage[most]{tcolorbox}
\RequirePackage{xcolor}
\RequirePackage{xparse}

%% 图片搜索路径
\graphicspath{{./}{figures/}}

%% 超链接样式
\hypersetup{
  unicode=true,
  colorlinks=true,
  linkcolor=blue,
  urlcolor=blue,
  citecolor=blue,
  bookmarksnumbered=true
}

%% 字体选择, 默认英文为 Times New Roman, 中文为宋体(默认)、微软雅黑(无衬线)
\setmainfont{Times New Roman}
\setmonofont{Consolas}
\setCJKmainfont{SimSun}[AutoFakeBold=true]
\setCJKsansfont{Microsoft YaHei}
\setCJKmonofont{SimSun}

%% 正文排版
\setlength{\parindent}{2em}
\setlength{\parskip}{0.35em}
\setlength{\headheight}{21pt}
\linespread{1.25}
\captionsetup{font=small,labelfont=bf,labelsep=quad}
\setlist{nosep,leftmargin=2em}

%% 章节标题
\renewcommand{\thesection}{\chinese{section}}
\renewcommand{\thesubsection}{\arabic{section}.\arabic{subsection}}
\ctexset{
  section = {
    number = \thesection,
    format = \Large\bfseries\raggedright,
    indent = 0pt
  }
}

%% 交叉引用命名
\def\equationautorefname{式}
\def\figureautorefname{图}
\def\tableautorefname{表}
\def\sectionautorefname{节}
\def\subsectionautorefname{小节}
\def\appendixautorefname{附录}

%% 用LaTeX3维护信息
\ExplSyntaxOn
\tl_new:N \g_zju_cover_name_tl
%\tl_new:N \g_zju_cover_subtitle_tl
\tl_new:N \g_zju_course_tl
\tl_new:N \g_zju_author_tl
\tl_new:N \g_zju_school_id_tl
\tl_new:N \g_zju_college_tl
\tl_new:N \g_zju_major_tl
\tl_new:N \g_zju_teacher_tl
\tl_new:N \g_zju_place_tl
\tl_new:N \g_zju_date_tl
\tl_new:N \g_zju_header_date_tl
\tl_new:N \g_zju_project_name_tl
\tl_new:N \g_zju_experiment_type_tl
\tl_new:N \g_zju_groupmate_tl

\tl_gset:Nn \g_zju_cover_name_tl {本科实验报告}
%\tl_gset:Nn \g_zju_cover_subtitle_tl {Undergraduate Lab Report}
\tl_gset:Nn \g_zju_course_tl {课程名称}
\tl_gset:Nn \g_zju_author_tl {姓名}
\tl_gset:Nn \g_zju_school_id_tl {学号}
\tl_gset:Nn \g_zju_college_tl {学院}
\tl_gset:Nn \g_zju_major_tl {专业}
\tl_gset:Nn \g_zju_teacher_tl {}
\tl_gset:Nn \g_zju_place_tl {实验地点}
\tl_gset:Nn \g_zju_date_tl {20\hspace{1.2cm}年\hspace{0.9cm}月\hspace{0.9cm}日}
\tl_gset:Nn \g_zju_header_date_tl {\today}
\tl_gset:Nn \g_zju_project_name_tl {}
\tl_gset:Nn \g_zju_experiment_type_tl {设计型实验}
\tl_gset:Nn \g_zju_groupmate_tl {}

\keys_define:nn { zjureport }
  {
    cover-name .tl_gset:N = \g_zju_cover_name_tl,
%   cover-subtitle .tl_gset:N = \g_zju_cover_subtitle_tl,
    course .tl_gset:N = \g_zju_course_tl,
    author .tl_gset:N = \g_zju_author_tl,
    school-id .tl_gset:N = \g_zju_school_id_tl,
    college .tl_gset:N = \g_zju_college_tl,
    major .tl_gset:N = \g_zju_major_tl,
    teacher .tl_gset:N = \g_zju_teacher_tl,
    place .tl_gset:N = \g_zju_place_tl,
    date .tl_gset:N = \g_zju_date_tl,
    header-date .tl_gset:N = \g_zju_header_date_tl,
    project-name .tl_gset:N = \g_zju_project_name_tl,
    experiment-type .tl_gset:N = \g_zju_experiment_type_tl,
    groupmate .tl_gset:N = \g_zju_groupmate_tl,
  }

\NewDocumentCommand{\zjusetup}{m}{\keys_set:nn { zjureport } {#1}}
\NewDocumentCommand{\zjuval}{m}{\tl_use:c { g_zju_#1_tl }}
\ExplSyntaxOff

%% 装订线
\newif\ifzjubindingline
\zjubindinglinefalse

\newcommand{\enablebindingline}{\zjubindinglinetrue}
\newcommand{\disablebindingline}{\zjubindinglinefalse}

\newsavebox{\zjubindinglinebox}

\AtBeginDocument{%
  \sbox{\zjubindinglinebox}{%
    \color{black!70}%
    \bfseries\fontsize{12pt}{14pt}\selectfont%
    \begin{tabular}{@{}c@{}}
      装\\[0.2em]
      订\\[0.2em]
      线
    \end{tabular}%
  }%
}

\newcommand{\zjubindingline}{%
  \ifzjubindingline
    \AtPageLowerLeft{%
      \put(0,0){%
        \makebox(0,0)[lb]{%
          \begin{tikzpicture}[remember picture,overlay]
            \coordinate (binding-top)
              at ([xshift=1.15cm,yshift=-2.5cm]current page.north west);
            \coordinate (binding-label)
              at ([xshift=1.15cm,yshift=-14.5cm]current page.north west);
            \coordinate (binding-bottom)
              at ([xshift=1.15cm,yshift=-28.7cm]current page.north west);

            \draw[black!70,dashed,line width=1pt]
              (binding-top) -- ([yshift=1.5cm]binding-label);

            \node[anchor=center,inner sep=0pt]
              at (binding-label)
              {\usebox{\zjubindinglinebox}};

            \draw[black!70,dashed,line width=1pt]
              ([yshift=-1.5cm]binding-label) -- (binding-bottom);
          \end{tikzpicture}%
        }%
      }%
    }%
  \fi
}

\AddToShipoutPictureBG{\zjubindingline}

%% 页眉页脚
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\fontsize{9pt}{11pt}\selectfont 实验名称：\zjuval{project_name}}
\fancyhead[C]{\fontsize{9pt}{11pt}\selectfont 姓名：\zjuval{author}}
\fancyhead[R]{\fontsize{9pt}{11pt}\selectfont 学号：\zjuval{school_id}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}

%% 下划线设置
\NewDocumentCommand{\zjuunderline}{O{4cm}m}{%
  \underline{\makebox[#1][c]{\strut #2}}%
}

\newsavebox{\zjuheaderfieldbox}
\newsavebox{\zjuheaderprojectbox}
\NewDocumentCommand{\zjuheaderfit}{m}{%
  \sbox{\zjuheaderfieldbox}{\strut #1}%
  \ifdim\wd\zjuheaderfieldbox>\linewidth%
    \resizebox{\linewidth}{!}{\usebox{\zjuheaderfieldbox}}%
  \else%
    \makebox[\linewidth][c]{\usebox{\zjuheaderfieldbox}}%
  \fi%
}
\NewDocumentCommand{\zjuheaderunderline}{m}{%
  \sbox{\zjuheaderfieldbox}{\strut #1}%
  \underline{%
    \ifdim\wd\zjuheaderfieldbox>\linewidth
      \resizebox{\linewidth}{!}{\usebox{\zjuheaderfieldbox}}%
    \else%
      \makebox[\linewidth][c]{\usebox{\zjuheaderfieldbox}}%
    \fi%
  }%
}

%% 封面设置
\newcommand{\zjucover}{
  \thispagestyle{empty}
  \begin{center}
    \vspace*{\fill}
    \includegraphics[width=\textwidth]{ZJU-Banner2.png}

    \vspace{0.5cm}
    {\heiti\fontsize{26pt}{32pt}\selectfont \zjuval{cover_name}\par}
    \vspace{0.5cm}
%   {\fontsize{17pt}{22pt}\selectfont \zjuval{cover_subtitle}\par}

    \vspace*{\fill}
    \begingroup
    \fontsize{14.5pt}{22pt}\selectfont
    \renewcommand{\arraystretch}{1.45}
    \begin{tabular}{@{}>{\centering\arraybackslash}p{6.5em}>{\centering\arraybackslash}p{8cm}@{}}
      课程名称： & \zjuunderline[8cm]{\zjuval{course}}\\
      姓\quad\quad 名： & \zjuunderline[8cm]{\zjuval{author}}\\
      学\quad\quad 号： & \zjuunderline[8cm]{\zjuval{school_id}}\\
      学\quad\quad 院： & \zjuunderline[8cm]{\zjuval{college}}\\
      专\quad\quad 业： & \zjuunderline[8cm]{\zjuval{major}}\\
      指导教师： & \zjuunderline[8cm]{\zjuval{teacher}}\\
      \multicolumn{2}{c}{\zjuval{date}}
    \end{tabular}
    \endgroup

    \vspace*{\fill}
  \end{center}
  \clearpage
}
\newcommand{\cover}{\zjucover}

%% 首页表头
\newcommand{\zjulabheader}{
  \begingroup
  \fontsize{9.5pt}{12pt}\selectfont
  \setlength{\tabcolsep}{0pt}
  \renewcommand{\arraystretch}{1.15}

  \begin{center}

    % ===== 上半部分 =====
    \begin{tabularx}{\textwidth}{@{}X@{\hfill}p{5.5cm}@{}}
      \centering\includegraphics[width=\linewidth]{head.jpg} &
      \centering
      \begin{tabular}{@{}p{1.5cm}p{4cm}@{}}
        \hspace{0.4cm}专业：& \zjuunderline[4cm]{\zjuval{major}}\\
        \hspace{0.4cm}姓名：& \zjuunderline[4cm]{\zjuval{author}}\\
        \hspace{0.4cm}学号：& \zjuunderline[4cm]{\zjuval{school_id}}\\
        \hspace{0.4cm}日期：& \zjuunderline[4cm]{\zjuval{header_date}}\\
        \hspace{0.4cm}地点：& \zjuunderline[4cm]{\zjuval{place}}
      \end{tabular}
    \end{tabularx}

    \vspace{0.25em}
    % ===== 下半部分 =====
    \setlength{\tabcolsep}{0pt}
    \renewcommand{\arraystretch}{1.25}
    \sbox{\zjuheaderprojectbox}{\strut\zjuval{project_name}}

    \begin{tabular}{@{}>{\raggedright\arraybackslash}p{0.10\textwidth}
                    >{\centering\arraybackslash}p{0.27\textwidth}
                    >{\raggedright\arraybackslash}p{0.10\textwidth}
                    >{\centering\arraybackslash}p{0.26\textwidth}
                    >{\raggedright\arraybackslash}p{0.14\textwidth}
                    >{\centering\arraybackslash}p{0.12\textwidth}@{}}
      课程名称： & \zjuheaderfit{\zjuval{course}} &
      指导教师： & \zjuheaderfit{\zjuval{teacher}} &
      成\quad\quad 绩： & \\[-0.15em]
      \cline{2-2}\cline{4-4}\cline{6-6}
      % ===== 换行 =====
      \ifdim\wd\zjuheaderprojectbox>0.27\textwidth%
        实验名称：&
        \multicolumn{3}{>{\centering\arraybackslash}p{0.57\textwidth}}{\zjuheaderfit{\zjuval{project_name}}} &
        实验类型：& \zjuheaderfit{\zjuval{experiment_type}}\\[-0.15em]
        \cline{2-4}\cline{6-6}
        & & & &
        同组学生姓名：& \zjuheaderfit{\zjuval{groupmate}}\\[-0.15em]
        \cline{6-6}
      \else%
        实验名称：& \zjuheaderfit{\zjuval{project_name}} &
        实验类型：& \zjuheaderfit{\zjuval{experiment_type}} &
        同组学生姓名：& \zjuheaderfit{\zjuval{groupmate}}\\[-0.15em]
        \cline{2-2}\cline{4-4}\cline{6-6}
      \fi%
    \end{tabular}

  \end{center}

  \endgroup
  \vspace{1em}
}

\NewDocumentCommand{\ISEEHeader}{O{}}{%
  \zjusetup{#1}%
  \enablebindingline
  \zjulabheader
}

%% 一些提示框
\newtcolorbox{zjubox}[2][]{
  enhanced,
  breakable,
  colback=#2!6,
  colframe=#2!65!black,
  boxrule=0.6pt,
  arc=1mm,
  left=1em,
  right=1em,
  top=0.75em,
  bottom=0.75em,
  #1
}

\NewDocumentCommand{\tbox}{m}{\begin{zjubox}{gray}#1\end{zjubox}}
\NewDocumentCommand{\notebox}{m}{\begin{zjubox}[title=Note]{blue}#1\end{zjubox}}
\NewDocumentCommand{\importantbox}{m}{\begin{zjubox}[title=Important]{green}#1\end{zjubox}}
\NewDocumentCommand{\warningbox}{m}{\begin{zjubox}[title=Warning]{orange}#1\end{zjubox}}
\NewDocumentCommand{\questionbox}{m}{\begin{zjubox}[title=Question]{purple}#1\end{zjubox}}

%% 代码块
\lstdefinestyle{zjucode}{
  basicstyle=\ttfamily\small,
  keywordstyle=\color{blue!70!black}\bfseries,
  commentstyle=\color{gray!80!black},
  stringstyle=\color{red!60!black},
  numbers=left,
  numberstyle=\tiny\color{gray},
  stepnumber=1,
  numbersep=0.8em,
  breaklines=true,
  columns=fullflexible,
  frame=single,
  rulecolor=\color{gray!45},
  backgroundcolor=\color{gray!6},
  tabsize=2
}
\lstset{style=zjucode}
\lstnewenvironment{codeblock}[1][]{\lstset{style=zjucode,#1}}{}
\NewDocumentCommand{\codex}{O{}m}{\lstinputlisting[style=zjucode,#1]{#2}}
\NewDocumentCommand{\mycode}{O{}m}{\lstinputlisting[style=zjucode,#1]{#2}}

